  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "admin@sah.com",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{contrasena}}",
        "type": "string"
      }
    ]
  },
