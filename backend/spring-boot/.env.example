# Copia este archivo como .env y completa los valores.
# .env esta en .gitignore: nunca se sube al repositorio.

# Base de datos (usuario creado con database/crear_usuario_app.sql)
DB_USER=sah_app
DB_PASSWORD=escribe_aqui_la_clave
# DB_URL=jdbc:mariadb://localhost:3306/security_awareness_hub

# Correo (Sesion 8). En desarrollo puede quedar en false.
MAIL_ENABLED=false
# Ejemplo con Gmail: usa una "contraseña de aplicación", no la clave normal
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_cuenta@gmail.com
# MAIL_PASSWORD=contraseña_de_aplicacion
# MAIL_FROM=tu_cuenta@gmail.com

# Datos iniciales (Sesion 6): solo se usan si NO hay ningun administrador
# activo en la base de datos (base nueva). Equivale a crear_admin.php.
# ADMIN_CORREO=admin@sah.com
# ADMIN_PASSWORD=escribe_una_clave_segura
