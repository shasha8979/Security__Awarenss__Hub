<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.3</version>
        <relativePath/>
    </parent>

    <groupId>com.sah</groupId>
    <artifactId>security-awareness-hub</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <name>Security Awareness Hub</name>
    <description>Plataforma de capacitación en seguridad digital</description>

    <properties>
        <java.version>21</java.version>
        <!-- Carpeta del frontend original: su CSS se usa tal cual en las vistas Java -->
        <frontend.dir>${project.basedir}/../../frontend</frontend.dir>
    </properties>

    <dependencies>

        <!-- Web MVC: API REST (@RestController) y páginas (@Controller) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Vistas HTML con Thymeleaf (ejercicio Gestor de Tareas) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Persistencia -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Seguridad -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validación -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Envio de correos (Sesion 8) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Base de datos MariaDB -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Pruebas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MockMvc: pruebas de integracion de la API REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Servidor SMTP en memoria para probar el envio de correos -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>2.1.3</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>

        <!--
            Además de src/main/resources, se copian a static/ los CSS e
            imágenes del frontend original. Así las vistas Thymeleaf usan
            exactamente los mismos archivos (una sola fuente de estilos):
              frontend/Interface_Administrador/css -> /admin/css/
              frontend/authentication/css          -> /auth/css/
              frontend/authentication/assets       -> /auth/assets/
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${frontend.dir}/Interface_Administrador/css</directory>
                <targetPath>static/admin/css</targetPath>
            </resource>
            <resource>
                <directory>${frontend.dir}/authentication/css</directory>
                <targetPath>static/auth/css</targetPath>
            </resource>
            <resource>
                <directory>${frontend.dir}/authentication/assets</directory>
                <targetPath>static/auth/assets</targetPath>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
